---
import { Image } from 'astro:assets';
import { clients } from '../data/site';
interface Props { trackId?: string; }
const { trackId = 'client-logo-track' } = Astro.props;
const instructionsId = `${trackId}-instructions`;
---
<div class="client-carousel" data-client-carousel>
  <div class="logo-viewport" role="region" aria-label="Logotipos de clientes">
    <div class="logo-track" id={trackId}>
      <div class="logo-group">
        {clients.map((client) => <div class="carousel-logo"><Image src={client.image} alt={client.name} width={150} height={65} fit="contain" format="webp" loading="lazy" /></div>)}
      </div>
      <div class="logo-group logo-copy" aria-hidden="true">
        {clients.map((client) => <div class="carousel-logo"><Image src={client.image} alt={client.name} width={150} height={65} fit="contain" format="webp" loading="lazy" /></div>)}
      </div>
    </div>
  </div>
  <span class="carousel-instructions" id={instructionsId} hidden>Espacio: pausar o reanudar. Esc: pausar.</span>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-client-carousel]').forEach((carousel) => {
    const viewport = carousel.querySelector<HTMLElement>('.logo-viewport');
    const instructions = carousel.querySelector<HTMLElement>('.carousel-instructions');
    if (!viewport || !instructions) return;
    let userPaused = false;
    let hovered = false;
    const update = () => {
      const paused = userPaused || hovered;
      carousel.classList.toggle('is-paused', paused);
      instructions.textContent = `${paused ? 'Movimiento pausado.' : 'Movimiento automático.'} Espacio: pausar o reanudar. Esc: pausar.`;
    };
    viewport.addEventListener('mouseenter', () => { hovered = true; update(); });
    viewport.addEventListener('mouseleave', () => { hovered = false; update(); });
    viewport.addEventListener('keydown', (event) => {
      if (event.key === ' ' || event.code === 'Space') {
        event.preventDefault();
        if (event.repeat) return;
        userPaused = !userPaused;
        update();
      } else if (event.key === 'Escape') {
        event.preventDefault();
        userPaused = true;
        update();
      }
    });
    viewport.tabIndex = 0;
    viewport.setAttribute('aria-describedby', instructions.id);
    instructions.hidden = false;
    update();
    carousel.classList.add('is-enabled');
  });
</script>
<style>
  .client-carousel { min-width: 0; position: relative; }
  .logo-group { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 24px; align-items: center; }
  .logo-copy { display: none; }
  .carousel-logo { display: flex; align-items: center; justify-content: center; height: 65px; min-width: 0; }
  .carousel-logo img { width: 100%; max-height: 65px; object-fit: contain; }
  .carousel-instructions { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .carousel-instructions[hidden] { display: none; }
  .is-enabled .logo-viewport:focus-visible { outline: 3px solid #0a1267; outline-offset: 6px; }
  .is-enabled:focus-within .carousel-instructions { position: static; display: block; width: auto; height: auto; clip-path: none; white-space: normal; margin-top: 15px; color: #5d657d; font-size: 11px; line-height: 1.8; }
  .is-enabled .logo-viewport { overflow: hidden; }
  .is-enabled .logo-track { display: flex; width: max-content; }
  .is-enabled .logo-group { display: flex; flex: 0 0 auto; gap: 42px; padding-right: 42px; }
  .is-enabled .carousel-logo { width: 150px; flex: 0 0 150px; }
  .client-carousel.is-enabled .logo-track { animation: client-logos-right 56s linear infinite !important; }
  .client-carousel.is-enabled.is-paused .logo-track,
  .client-carousel.is-enabled .logo-viewport:hover .logo-track { animation-play-state: paused !important; }
  @keyframes client-logos-right {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }
  @media (max-width: 900px) {
    .logo-group { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 18px; }
  }
  @media (max-width: 650px) {
    .carousel-logo { height: 42px; }
    .carousel-logo img { max-height: 42px; }
    .is-enabled .carousel-logo { width: 110px; flex-basis: 110px; }
    .is-enabled .logo-group { gap: 28px; padding-right: 28px; }
  }
</style>
