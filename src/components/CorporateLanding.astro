---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import JJBrand from './JJBrand.astro';
import Icon from './Icon.astro';
import CorporateContact from './CorporateContact.astro';
import { company, clients } from '../data/site';
import { corporate } from '../data/corporate';
import advisory from '../assets/photos/advisory.jpg';
import finance from '../assets/photos/finance.jpg';
---
<BaseLayout demo title={corporate.title} description={corporate.description} siteName={corporate.name} favicon="/jj-favicon.svg">
  <div class="corporate-demo">
    <div class="c-utility"><div class="c-container"><span>PERÚ · AUDITORÍA Y CONSULTORÍA EMPRESARIAL</span><span>Demo corporativa · Vista previa</span></div></div>
    <header class="c-header"><div class="c-container c-header-inner"><JJBrand /><button id="corporate-menu-toggle" type="button" aria-controls="corporate-navigation" aria-expanded="false" aria-label="Abrir menú de navegación" hidden><span></span><span></span></button><nav id="corporate-navigation" aria-label="Navegación principal">{corporate.navigation.map((item) => <a href={item.href}>{item.label}</a>)}<a class="c-button c-nav-cta" href="#contacto">Solicitar propuesta <Icon /></a></nav></div></header>
    <main id="contenido">
      <section id="inicio" class="c-hero">
        <div class="c-hero-copy"><span class="c-eyebrow">PARA MEDIANAS Y GRANDES EMPRESAS</span><h1>Una mirada independiente.<br /><span>Decisiones mejor fundamentadas.</span></h1><p>Auditoría financiera y tributaria para evaluar información, identificar riesgos y fortalecer el control de tu organización.</p><a class="c-button c-button-light" href="#contacto">Conversemos sobre tu empresa <Icon /></a><div class="c-hero-footnote"><span>INDEPENDENCIA</span><span>CRITERIO PROFESIONAL</span><span>CONFIDENCIALIDAD</span></div></div>
        <div class="c-hero-photo"><Image src={advisory} alt="Revisión profesional de documentos financieros, fotografía ilustrativa" widths={[640, 1000, 1400]} sizes="(max-width: 650px) 100vw, 50vw" format="webp" loading="eager" fetchpriority="high" /><div class="c-photo-caption"><span>UNA PERSPECTIVA MÁS CLARA</span><strong>La confianza comienza<br />con información rigurosa.</strong><Icon /></div></div>
      </section>

      <section class="c-introduction"><div class="c-container c-introduction-grid"><span class="c-eyebrow c-eyebrow-dark">AUDITORÍA CON PROPÓSITO</span><div><h2>Cuando la complejidad crece,<br />el criterio hace la diferencia.</h2><p>La información financiera y los controles merecen una evaluación que vaya más allá de los números. Nuestra propuesta combina una revisión independiente con hallazgos y recomendaciones útiles para la gestión empresarial.</p></div><div class="c-intro-note"><Icon name="shield" /><span>Evaluar con rigor.<br />Comunicar con claridad.<br />Priorizar lo relevante.</span></div></div></section>

      <section id="especialidades" class="c-specialties"><div class="c-container"><div class="c-section-heading"><span class="c-eyebrow c-eyebrow-dark">NUESTRAS ESPECIALIDADES</span><h2>Una evaluación integral.<br />Un alcance bien definido.</h2><p>Tres perspectivas complementarias para entender la información, los riesgos y los procesos de tu organización.</p></div><div class="c-specialty-list">{corporate.specialties.map((service) => <article class="c-specialty"><span class="c-specialty-number">{service.number}</span><div><h3>{service.title}</h3><p>{service.description}</p><span class="c-scope">{service.scope}</span></div><a href="#contacto" aria-label={`Solicitar propuesta de ${service.title}`}><Icon /></a></article>)}</div></div></section>

      <section id="enfoque" class="c-approach"><div class="c-container c-approach-grid"><div class="c-approach-visual"><Image src={finance} alt="Análisis de gráficos y reportes financieros en una computadora, fotografía ilustrativa" widths={[500, 800, 1100]} sizes="(max-width: 900px) 90vw, 40vw" format="webp" loading="lazy" /><div class="c-approach-caption"><span>DEL CONTEXTO A LA ACCIÓN</span><strong>Un proceso claro,<br />sin perder profundidad.</strong></div></div><div><div class="c-section-heading"><span class="c-eyebrow c-eyebrow-dark">NUESTRO ENFOQUE</span><h2>Rigor en la evaluación.<br />Claridad en cada etapa.</h2></div><ol class="c-steps">{corporate.steps.map((step, index) => <li><span>0{index + 1}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol></div></div></section>

      <section id="firma" class="c-firm"><div class="c-container c-firm-grid"><div><span class="c-eyebrow">EXPERIENCIA Y CRITERIO</span><h2>Una relación profesional.<br />Un compromiso cercano.</h2><p>Somos una firma peruana de auditoría y consultoría empresarial. Nuestros socios cuentan con 20 años de experiencia en los sectores comercial, industrial y construcción.</p><p>Trabajamos con integridad, confidencialidad y atención personalizada. Explicamos los hallazgos de manera clara para que la información contribuya a decisiones mejor fundamentadas.</p></div><div class="c-experience"><strong>20<span>años</span></strong><p>de experiencia<br />de nuestros socios</p><span class="c-experience-detail">Sector comercial<br />Industria<br />Construcción</span></div></div></section>

      <section class="c-clients" aria-labelledby="corporate-clients-title"><div class="c-container"><div class="c-clients-heading"><h2 id="corporate-clients-title">Relaciones que acompañan nuestra experiencia.</h2><span>COMPROMISO EN CADA ENCARGO</span></div><div class="c-client-grid">{clients.map((client) => <div><Image src={client.image} alt={client.name} width={150} height={65} fit="contain" format="webp" loading="lazy" /></div>)}</div></div></section>

      <section class="c-faq"><div class="c-container c-faq-grid"><div class="c-section-heading"><span class="c-eyebrow c-eyebrow-dark">ANTES DE COMENZAR</span><h2>El alcance comienza<br />con una conversación.</h2><p>Respuestas para entender mejor una propuesta de auditoría.</p></div><div class="c-faq-list">{corporate.faqs.map((faq) => <details><summary><span>{faq.question}</span><Icon name="plus" /></summary><p>{faq.answer}</p></details>)}</div></div></section>
      <CorporateContact />
    </main>
    <footer class="c-footer"><div class="c-container c-footer-top"><JJBrand light /><p>Independencia para evaluar.<br />Claridad para decidir.</p><a href="#inicio">Volver al inicio <Icon /></a></div><div class="c-container c-footer-bottom"><span>© {new Date().getFullYear()} {company.legalName}</span><span>Demo 2 · Vista previa · Datos de ejemplo</span></div></footer>
  </div>
</BaseLayout>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('#corporate-menu-toggle');
  const nav = document.querySelector<HTMLElement>('#corporate-navigation');
  if (toggle && nav) {
    toggle.hidden = false;
    nav.classList.add('c-enhanced');
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menú de navegación');
      nav.classList.remove('c-open');
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      nav.classList.toggle('c-open', open);
    });
    nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        close();
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 901px)').addEventListener('change', close);
  }
</script>
<style>
  .corporate-demo { color: #1e2840; background: #fff; }
  .c-container { width: min(1200px, calc(100% - 80px)); margin-inline: auto; }
  .c-utility { background: #f1f2f5; color: #626a7e; font-size: 8px; letter-spacing: 1px; }
  .c-utility > div { display: flex; justify-content: space-between; gap: 20px; padding-block: 12px; }
  .c-header { position: sticky; top: 0; background: #fff; z-index: 30; border-bottom: 1px solid #e1e4eb; }
  .c-header-inner { display: flex; align-items: center; justify-content: space-between; gap: 25px; min-height: 93px; }
  #corporate-navigation { display: flex; align-items: center; gap: 36px; }
  #corporate-navigation > a:not(.c-button) { font-size: 11px; color: #35415b; }
  #corporate-navigation > a:not(.c-button):hover { color: #0a1267; }
  .c-button { display: inline-flex; align-items: center; justify-content: space-between; gap: 35px; background: #0a1267; color: white; padding: 17px 23px; min-height: 53px; border: 1px solid #0a1267; font-size: 11px; font-weight: 600; transition: background .2s; }
  .c-button:hover { background: #202e89; }
  .c-button svg { width: 19px; height: 19px; }
  .c-nav-cta { min-height: 44px; padding: 13px 19px; font-size: 10px; gap: 23px; }
  .c-button-light { background: #fff; color: #0a1267; border-color: #fff; }
  .c-button-light:hover { background: #e8ebfa; }
  #corporate-menu-toggle { display: none; background: #fff; width: 43px; height: 43px; border: 1px solid #dce0e9; padding: 10px; }
  #corporate-menu-toggle span { width: 21px; height: 2px; background: #0a1267; display: block; margin-block: 5px; transition: transform .2s; }
  .c-eyebrow { display: block; font-size: 9px; font-weight: 600; line-height: 1.8; letter-spacing: 1.8px; color: #b6c0ec; }
  .c-eyebrow-dark { color: #556382; }
  .c-hero { display: grid; grid-template-columns: 1fr 1fr; background: #0a1267; }
  .c-hero-copy { padding: 84px 65px 44px max(40px, calc((100vw - 1200px) / 2)); color: white; }
  .c-hero h1 { font-size: clamp(40px, 3.8vw, 57px); font-weight: 500; line-height: 1.18; letter-spacing: -2.3px; margin-top: 27px; }
  .c-hero h1 span { color: #bac5f1; }
  .c-hero-copy > p { margin-top: 27px; font-size: 14px; color: #c8d0ec; max-width: 430px; line-height: 1.85; }
  .c-hero-copy > .c-button { margin-top: 33px; }
  .c-hero-footnote { margin-top: 61px; display: flex; gap: 21px; color: #c3cdec; font-size: 7px; letter-spacing: .7px; flex-wrap: wrap; }
  .c-hero-footnote span + span { border-left: 1px solid #5e6ba8; padding-left: 21px; }
  .c-hero-photo { position: relative; min-height: 630px; overflow: hidden; }
  .c-hero-photo > :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 44% center; filter: saturate(.65); }
  .c-photo-caption { position: absolute; left: 0; bottom: 0; right: 0; display: grid; grid-template-columns: 1fr auto; padding: 27px 38px; color: white; background: #0e1631ed; }
  .c-photo-caption > span { grid-column: 1 / -1; font-size: 8px; letter-spacing: 1.7px; color: #c1cae8; margin-bottom: 11px; }
  .c-photo-caption > strong { font-size: 23px; line-height: 1.4; font-weight: 500; letter-spacing: -.4px; }
  .c-photo-caption > svg { align-self: end; margin-bottom: 5px; }
  .c-introduction { padding-block: 71px; border-bottom: 1px solid #e2e5ea; }
  .c-introduction-grid { display: grid; grid-template-columns: .55fr 1.3fr .55fr; gap: 50px; align-items: start; }
  .c-introduction-grid > .c-eyebrow { padding-top: 7px; font-size: 8px; }
  .c-introduction h2 { font-size: 30px; line-height: 1.4; letter-spacing: -1px; font-weight: 500; color: #0a1267; }
  .c-introduction p { margin-top: 20px; font-size: 13px; max-width: 610px; }
  .c-intro-note { border-left: 1px solid #dbe0e9; padding: 7px 0 7px 25px; display: grid; gap: 18px; color: #0a1267; }
  .c-intro-note > svg { width: 26px; }
  .c-intro-note > span { color: #626a7d; font-size: 11px; line-height: 1.9; }
  .c-specialties { background: #f7f8fa; padding-block: 99px; }
  .c-section-heading h2 { color: #0a1267; font-size: 40px; letter-spacing: -1.5px; line-height: 1.3; font-weight: 500; margin-top: 20px; }
  .c-section-heading p { font-size: 13px; margin-top: 20px; max-width: 540px; }
  .c-specialties .c-section-heading { display: grid; grid-template-columns: 1.3fr 1fr; gap: 0 80px; }
  .c-specialties .c-section-heading > .c-eyebrow { grid-column: 1 / -1; }
  .c-specialties .c-section-heading p { align-self: end; padding-bottom: 5px; }
  .c-specialty-list { margin-top: 47px; border-top: 1px solid #cfd6e2; }
  .c-specialty { display: grid; grid-template-columns: 95px 1fr 60px; gap: 35px; padding-block: 34px; border-bottom: 1px solid #d7dce5; }
  .c-specialty-number { font-size: 42px; font-weight: 400; color: #838eaa; letter-spacing: -2px; line-height: 1; margin-top: 5px; }
  .c-specialty h3 { font-size: 24px; font-weight: 500; letter-spacing: -.6px; color: #0a1267; }
  .c-specialty p { font-size: 13px; max-width: 790px; margin-top: 13px; }
  .c-scope { display: block; font-size: 9px; color: #606a80; letter-spacing: .4px; margin-top: 18px; }
  .c-specialty > a { width: 48px; height: 48px; display: grid; place-items: center; align-self: center; border: 1px solid #cbd2e1; color: #0a1267; transition: background .2s; }
  .c-specialty > a:hover { background: #e7ebf5; }
  .c-specialty > a svg { width: 22px; }
  .c-approach { padding-block: 105px; }
  .c-approach-grid { display: grid; grid-template-columns: .9fr 1fr; gap: 96px; align-items: start; }
  .c-approach-visual { position: relative; min-height: 548px; overflow: hidden; margin-top: 10px; }
  .c-approach-visual > :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 40% center; filter: saturate(.7); }
  .c-approach-caption { position: absolute; left: 0; right: 0; bottom: 0; background: #0a1267; padding: 25px 30px; color: white; }
  .c-approach-caption span { display: block; font-size: 8px; letter-spacing: 1.5px; color: #b9c4ed; margin-bottom: 10px; }
  .c-approach-caption strong { font-size: 23px; line-height: 1.4; font-weight: 500; }
  .c-approach .c-section-heading h2 { font-size: 36px; }
  .c-steps { list-style: none; padding: 0; margin: 30px 0 0; }
  .c-steps li { display: flex; gap: 25px; padding-block: 20px; border-top: 1px solid #dce1e9; }
  .c-steps li > span { color: #62697b; font-size: 13px; margin-top: 4px; }
  .c-steps h3 { font-size: 15px; font-weight: 600; color: #0a1267; }
  .c-steps p { font-size: 12px; margin-top: 8px; }
  .c-firm { background: #0a1267; padding-block: 84px; }
  .c-firm-grid { display: grid; grid-template-columns: 1.4fr .6fr; gap: 130px; align-items: center; }
  .c-firm h2 { font-size: 37px; font-weight: 500; color: white; letter-spacing: -1.4px; line-height: 1.35; margin-top: 21px; }
  .c-firm p { font-size: 13px; color: #c2cbed; margin-top: 23px; max-width: 630px; }
  .c-experience { border-left: 1px solid #505c9a; padding-left: 54px; }
  .c-experience > strong { display: flex; align-items: baseline; gap: 15px; font-size: 93px; color: white; font-weight: 400; line-height: 1; letter-spacing: -5px; }
  .c-experience > strong span { font-size: 19px; letter-spacing: 0; color: #c5ceee; }
  .c-experience > p { font-size: 14px; margin-top: 11px; }
  .c-experience-detail { display: block; border-top: 1px solid #505c9a; padding-top: 18px; margin-top: 22px; color: #b7c3e9; font-size: 9px; line-height: 2; }
  .c-clients { padding-block: 43px; border-bottom: 1px solid #e1e5ed; }
  .c-clients-heading { display: flex; justify-content: space-between; gap: 30px; align-items: center; margin-bottom: 30px; }
  .c-clients-heading h2 { font-size: 12px; font-weight: 500; color: #536078; }
  .c-clients-heading > span { font-size: 8px; letter-spacing: 1px; color: #67718b; }
  .c-client-grid { display: grid; grid-template-columns: repeat(10, 1fr); gap: 25px; }
  .c-client-grid > div { height: 45px; display: flex; align-items: center; justify-content: center; }
  .c-client-grid :global(img) { max-height: 43px; object-fit: contain; filter: grayscale(1); opacity: .78; }
  .c-faq { padding-block: 100px; }
  .c-faq-grid { display: grid; grid-template-columns: .9fr 1fr; gap: 95px; }
  .c-faq .c-section-heading h2 { font-size: 35px; }
  .c-faq-list details { border-bottom: 1px solid #dce1ea; }
  .c-faq-list details:first-child { border-top: 1px solid #dce1ea; }
  .c-faq-list summary { display: flex; gap: 20px; align-items: center; list-style: none; padding-block: 25px; color: #0a1267; font-size: 12px; font-weight: 500; cursor: pointer; line-height: 1.8; }
  .c-faq-list summary::-webkit-details-marker { display: none; }
  .c-faq-list summary > :global(svg) { width: 19px; margin-left: auto; flex-shrink: 0; transition: transform .2s; }
  .c-faq-list details[open] summary > :global(svg) { transform: rotate(45deg); }
  .c-faq-list details p { font-size: 12px; padding-bottom: 24px; padding-right: 27px; }
  .c-footer { padding-top: 48px; background: #080d37; }
  .c-footer-top { display: flex; justify-content: space-between; align-items: center; gap: 30px; padding-bottom: 33px; }
  .c-footer-top :global(.brand) { color: white; }
  .c-footer-top :global(.brand-dot) { color: #b5c0ed; }
  .c-footer-top p { font-size: 12px; color: #c2cae8; }
  .c-footer-top > a { display: flex; align-items: center; gap: 15px; font-size: 10px; color: #c2cae8; }
  .c-footer-top > a :global(svg) { width: 18px; transform: rotate(-90deg); }
  .c-footer-bottom { display: flex; justify-content: space-between; gap: 20px; border-top: 1px solid #353d68; padding-block: 23px; font-size: 9px; color: #aebbdc; }
  @media (max-width: 1100px) {
    .c-container { width: calc(100% - 56px); }
    .c-hero-copy { padding: 68px 38px 40px 28px; }
    .c-hero h1 { font-size: 44px; }
    .c-hero-photo { min-height: 620px; }
    .c-hero-footnote { gap: 13px; font-size: 6px; }
    .c-hero-footnote span + span { padding-left: 13px; }
    .c-introduction-grid { gap: 30px; }
    .c-approach-grid { gap: 50px; }
    .c-firm-grid { gap: 70px; }
    .c-faq-grid { gap: 50px; }
    .c-experience { padding-left: 35px; }
    .c-client-grid { gap: 20px; }
  }
  @media (max-width: 900px) {
    .c-header-inner { min-height: 79px; flex-wrap: wrap; }
    #corporate-menu-toggle:not([hidden]) { display: block; }
    #corporate-navigation { width: 100%; justify-content: center; gap: 25px; padding-bottom: 20px; flex-wrap: wrap; }
    #corporate-navigation.c-enhanced { display: none; }
    #corporate-navigation.c-open { display: flex; }
    #corporate-menu-toggle[aria-expanded='true'] span:first-child { transform: translateY(3.5px) rotate(45deg); }
    #corporate-menu-toggle[aria-expanded='true'] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
    .c-hero-copy { padding-right: 28px; }
    .c-hero h1 { font-size: 38px; letter-spacing: -1.5px; }
    .c-hero-copy > p { font-size: 13px; }
    .c-hero-copy > .c-button { font-size: 10px; padding-inline: 16px; gap: 18px; }
    .c-hero-footnote { display: grid; gap: 10px; margin-top: 40px; font-size: 7px; }
    .c-hero-footnote span + span { border-left: 0; padding-left: 0; }
    .c-photo-caption { padding: 25px; }
    .c-photo-caption > strong { font-size: 21px; }
    .c-introduction { padding-block: 55px; }
    .c-introduction-grid { grid-template-columns: 1fr .4fr; gap: 25px 40px; }
    .c-introduction-grid > .c-eyebrow { grid-column: 1 / -1; }
    .c-specialties, .c-approach, .c-faq { padding-block: 70px; }
    .c-section-heading h2 { font-size: 35px; }
    .c-specialties .c-section-heading { gap: 0 40px; }
    .c-specialty { grid-template-columns: 65px 1fr 48px; gap: 20px; }
    .c-specialty h3 { font-size: 23px; }
    .c-approach-grid { grid-template-columns: 1fr; gap: 42px; }
    .c-approach-visual { min-height: 380px; margin-top: 0; }
    .c-approach-visual > :global(img) { object-position: center 40%; }
    .c-approach-caption { width: 320px; left: auto; padding: 23px 27px; }
    .c-firm { padding-block: 65px; }
    .c-firm-grid { gap: 45px; }
    .c-firm h2 { font-size: 31px; }
    .c-experience > strong { font-size: 77px; gap: 10px; }
    .c-experience > strong span { font-size: 15px; }
    .c-client-grid { grid-template-columns: repeat(5, 1fr); gap: 24px; }
    .c-clients-heading > span { display: none; }
    .c-faq-grid { grid-template-columns: 1fr; gap: 35px; }
    .c-footer-bottom { font-size: 8px; }
  }
  @media (max-width: 650px) {
    .c-container { width: calc(100% - 40px); }
    .c-utility > div { padding-block: 11px; }
    .c-utility span { font-size: 7px; letter-spacing: .65px; }
    .c-utility span:last-child { display: none; }
    .c-header-inner { min-height: 74px; }
    #corporate-navigation.c-open { flex-direction: column; align-items: stretch; gap: 0; }
    #corporate-navigation > a:not(.c-button) { border-top: 1px solid #e1e5ed; padding-block: 15px; font-size: 12px; }
    .c-nav-cta { margin-top: 7px; }
    .c-hero { grid-template-columns: 1fr; }
    .c-hero-copy { padding: 52px 20px 36px; }
    .c-eyebrow { font-size: 8px; letter-spacing: 1.5px; }
    .c-hero h1 { font-size: clamp(36px, 10vw, 49px); line-height: 1.2; margin-top: 23px; }
    .c-hero-copy > p { font-size: 13px; margin-top: 24px; }
    .c-hero-copy > .c-button { font-size: 11px; padding-inline: 19px; margin-top: 27px; }
    .c-hero-footnote { display: flex; flex-wrap: wrap; gap: 12px; font-size: 6px; margin-top: 32px; }
    .c-hero-photo { min-height: 350px; }
    .c-photo-caption { padding: 22px 20px; }
    .c-photo-caption > strong { font-size: 23px; }
    .c-photo-caption > span { font-size: 7px; }
    .c-introduction { padding-block: 50px; }
    .c-introduction-grid { grid-template-columns: 1fr; gap: 23px; }
    .c-introduction h2 { font-size: 29px; }
