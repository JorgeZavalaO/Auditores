---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import JJBrand from './JJBrand.astro';
import Icon from './Icon.astro';
import ServiceCatalog from './ServiceCatalog.astro';
import { serviceCatalog } from '../data/serviceCatalog';
import { company } from '../data/site';
import finance from '../assets/photos/finance.jpg';
const home = '/';
const contactEmail = company.email;
const contactPhone = company.phone;
const identity = 'J&J CONSULTORES Y AUDITORES';
const content = {
  eyebrow: 'SOLUCIONES PARA EL DÍA A DÍA Y LO QUE VIENE', title: 'El respaldo que tu empresa necesita para avanzar.', intro: 'Desde la gestión contable y laboral hasta la auditoría y la tecnología. Encuentra un servicio que responda al momento de tu negocio.', contact: 'Encontrar mi solución', label: 'CONTABILIDAD · PERSONAS · CONFIANZA',
};
---
<BaseLayout title={`Servicios contables y de auditoría | ${identity}`} description={`${identity}: auditoría, outsourcing contable, planillas, procesos, regularización y consultoría ERP. Diagnóstico contable y tributario gratuito.`} siteName={identity} favicon="/jj-favicon.svg">
  <div class="services-page service-demo1">
    <div class="sp-notice"><div class="sp-container"><span>PERÚ · CONSULTORÍA EMPRESARIAL</span><span>{identity}</span></div></div>
    <header class="sp-header">
      <div class="sp-container sp-header-inner">
        <JJBrand href={home} />
        <nav aria-label="Navegación principal">
          <a href={home}>Inicio</a><a href="/servicios/" aria-current="page">Servicios</a><a href="/nosotros/">Nosotros</a><a href={`${home}#contacto`} class="sp-contact-link">Conversemos <Icon /></a>
        </nav>
      </div>
    </header>
    <main id="contenido">
      <section class="sp-hero" id="inicio">
        <div class="sp-container">
          <nav class="sp-breadcrumb" aria-label="Ruta de navegación"><a href={home}>Inicio</a><span aria-hidden="true">/</span><span>Servicios</span></nav>
          <div class="sp-hero-grid">
            <div class="sp-hero-copy"><span class="sp-eyebrow">{content.eyebrow}</span><h1>{content.title}</h1><p>{content.intro}</p><a class="sp-button" href="#diagnostico">Comenzar con un diagnóstico gratuito <Icon /></a></div>
            <div class="sp-hero-photo"><Image src={finance} alt="Análisis de información financiera y reportes, fotografía ilustrativa" widths={[480, 800, 1100]} sizes="(max-width: 700px) 90vw, 45vw" format="webp" loading="eager" fetchpriority="high" /><span>{content.label}</span></div>
          </div>
        </div>
      </section>
      <section class="sp-catalog sp-container" id="catalogo" aria-labelledby="catalog-title">
        <div class="sp-catalog-intro"><span class="sp-eyebrow">UN PORTAFOLIO, DIFERENTES NECESIDADES</span><h2 id="catalog-title">Encuentra tu punto de partida.</h2><p>Cada servicio parte de entender tu situación y definir un alcance claro. Explora las áreas de trabajo y el valor que pueden aportar a tu empresa.</p></div>
        <div class="sp-catalog-layout">
          <nav class="sp-index" aria-label="Índice de servicios"><span>EXPLORAR SERVICIOS</span><ol>{serviceCatalog.map((service) => <li><a href={`#${service.id}`}>{service.shortTitle}<Icon /></a></li>)}</ol></nav>
          <div class="sp-detail"><ServiceCatalog home={home} /></div>
        </div>
      </section>
      <section class="sp-next"><div class="sp-container"><div><span class="sp-eyebrow">EL SIGUIENTE PASO</span><h2>Una conversación para entender lo que necesitas.</h2><p>Cuéntanos sobre tu empresa y el servicio de interés. El formulario de contacto es una vista previa: no envía ni guarda información.</p></div><a class="sp-button" href={`${home}#contacto`}>{content.contact}<Icon /></a></div></section>
    </main>
    <footer class="sp-footer"><div class="sp-container sp-footer-top"><JJBrand light href={home} /><p>Criterio profesional.<br />Acompañamiento cercano.</p><a href={home}>Volver a la página principal <Icon /></a></div><div class="sp-container sp-example"><span>Correo de contacto</span><a class="sp-email" href={`mailto:${contactEmail}`}>{contactEmail}</a><span>Teléfono de contacto</span><a class="sp-phone" href={`tel:${contactPhone.replace(/\s/g, '')}`}>{contactPhone}</a></div><div class="sp-container sp-footer-bottom"><span>© {new Date().getFullYear()} {company.legalName}</span><span>Consultoría empresarial · Perú</span></div></footer>
  </div>
</BaseLayout>
<style>
  .services-page { color: #50596d; background: #f6f8fc; }
  .sp-container { width: min(1160px, calc(100% - 80px)); margin-inline: auto; }
  .sp-notice { background: #0a1267; color: #e5e9ff; font-size: 10px; letter-spacing: .06em; }
  .sp-notice > div { display: flex; justify-content: space-between; padding-block: 11px; gap: 15px; }
  .sp-header { background: #fff; border-bottom: 1px solid #e4e7ee; }
  .sp-header-inner { display: flex; justify-content: space-between; align-items: center; padding-block: 22px; gap: 35px; }
  .service-demo1 .sp-header :global(.jj-monogram) { font-size: 59px; }
  .service-demo1 .sp-header :global(.jj-monogram span) { font-size: 34px; }
  .service-demo1 .sp-header :global(.jj-wordmark) { font-size: 10px; }
  .sp-header nav { display: flex; gap: 30px; align-items: center; }
  .sp-header nav a { color: #0a1267; font-size: 12px; font-weight: 700; }
  .sp-contact-link { display: flex; align-items: center; gap: 12px; }
  .sp-header svg, .sp-footer svg { width: 19px; height: 19px; }
  .sp-breadcrumb { display: flex; gap: 15px; font-size: 11px; margin-bottom: 44px; }
  .sp-breadcrumb a { text-decoration: underline; text-underline-offset: 4px; }
  .sp-hero { padding: 34px 0 75px; }
  .sp-hero-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 65px; align-items: center; }
  .sp-eyebrow { display: block; font-size: 10px; font-weight: 800; letter-spacing: .13em; color: #0a1267; line-height: 1.7; }
  h1 { font-size: clamp(35px, 4.4vw, 57px); line-height: 1.15; letter-spacing: -2px; color: #0a1267; margin-top: 22px; }
  .sp-hero-copy > p { font-size: 15px; line-height: 1.9; margin: 26px 0; max-width: 510px; }
  .sp-button { display: inline-flex; align-items: center; justify-content: space-between; gap: 20px; padding: 18px 23px; background: #0a1267; color: #fff; font-size: 12px; font-weight: 700; line-height: 1.6; }
  .sp-button svg { width: 20px; height: 20px; flex: 0 0 auto; }
  .sp-hero-photo { position: relative; min-width: 0; }
  .sp-hero-photo img { width: 100%; height: 390px; object-fit: cover; }
  .sp-hero-photo > span { display: block; padding: 18px 20px; color: #fff; background: #0a1267; font-size: 9px; letter-spacing: .1em; }
  .sp-catalog { padding-block: 72px 95px; scroll-margin-top: 25px; }
  .sp-catalog-intro { max-width: 640px; margin-bottom: 38px; }
  .sp-catalog-intro h2, .sp-next h2 { color: #0a1267; font-size: clamp(29px, 3vw, 38px); line-height: 1.3; margin: 17px 0; }
  .sp-catalog-intro p, .sp-next p { font-size: 14px; line-height: 1.9; }
  .sp-index { margin-bottom: 35px; }
  .sp-index > span { display: block; font-size: 10px; font-weight: 800; letter-spacing: .1em; color: #0a1267; margin-bottom: 16px; }
  .sp-index ol { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; }
  .sp-index a { display: flex; align-items: center; gap: 16px; border: 1px solid #d6dce8; background: #fff; padding: 12px 16px; color: #0a1267; font-size: 11px; font-weight: 700; }
  .sp-index svg { width: 16px; height: 16px; }
  .sp-next { background: #e9eefb; padding-block: 60px; }
  .sp-next > div { display: flex; align-items: center; justify-content: space-between; gap: 55px; }
  .sp-next > div > div { max-width: 610px; }
  .sp-next .sp-button { flex-shrink: 0; }
  .sp-footer { background: #080e45; color: #d5dcf5; padding-block: 45px 24px; }
  .sp-footer-top { display: flex; align-items: center; justify-content: space-between; gap: 35px; }
  .sp-footer p { font-size: 12px; line-height: 1.9; color: #d5dcf5; }
  .sp-footer a:not(:global(.jj-brand)) { display: inline-flex; gap: 15px; font-size: 11px; align-items: center; }
  .sp-example { display: flex; flex-wrap: wrap; gap: 22px; margin-top: 35px; font-size: 11px; }
  .sp-example > span:first-child { color: #fff; font-weight: 800; }
  .sp-email, .sp-phone { color: #d5dcf5; }
  .sp-email:focus-visible, .sp-phone:focus-visible { outline: 2px solid #d5dcf5; outline-offset: 3px; }
  .sp-footer-bottom { display: flex; justify-content: space-between; gap: 20px; font-size: 10px; border-top: 1px solid #333965; margin-top: 26px; padding-top: 23px; }
  .service-demo1 .sp-hero-photo { border: 12px solid #fff; box-shadow: 16px 16px 0 #dfe6f9; }
  @media (max-width: 900px) {
    .sp-container { width: calc(100% - 48px); }
    .sp-header-inner { gap: 24px; flex-wrap: wrap; }
    .sp-header nav { gap: 24px; }
    .sp-hero-grid { gap: 30px; }
    .sp-next > div { display: block; }
    .sp-next .sp-button { margin-top: 28px; }
  }
  @media (max-width: 700px) {
    .sp-container { width: calc(100% - 40px); }
    .sp-notice > div { flex-wrap: wrap; font-size: 9px; }
    .sp-header-inner { padding-block: 20px; }
    .service-demo1 .sp-header :global(.jj-monogram) { font-size: 46px; }
    .service-demo1 .sp-header :global(.jj-monogram span) { font-size: 26px; }
    .service-demo1 .sp-header :global(.jj-wordmark) { font-size: 8px; }
    .sp-header nav { flex-wrap: wrap; gap: 16px 23px; }
  .sp-hero-grid { display: block; }
    .sp-hero-copy { padding-bottom: 30px; }
  .sp-hero-copy > p { margin-block: 24px; }
  .sp-hero-photo img { height: 280px; min-height: 0; }
    h1 { letter-spacing: -1px; }
    .sp-breadcrumb { margin-bottom: 30px; }
    .sp-catalog { padding-block: 45px 60px; }
    .sp-footer-top, .sp-footer-bottom { flex-direction: column; align-items: flex-start; gap: 24px; }
    .sp-example { gap: 15px; }
  }
</style>
