---
import Brand from './Brand.astro';
import JJBrand from './JJBrand.astro';
import Icon from './Icon.astro';
import { company, navigation } from '../data/site';
interface Props {
  branded?: boolean;
  servicesHref?: string;
  aboutHref?: string;
  homeHref?: string;
  anchorBase?: string;
  aboutCurrent?: boolean;
}
const { branded = false, servicesHref = '#servicios', aboutHref = '#nosotros', homeHref = '#inicio', anchorBase = '', aboutCurrent = false } = Astro.props;
const navigationHref = (href: string) => href === '#servicios' ? servicesHref : href === '#nosotros' ? aboutHref : `${anchorBase}${href}`;
---
<div class="utility-bar">
  <div class="container utility-inner">
    <span>Una mirada clara para tu empresa.</span>
    <div class="utility-contacts"><span class="example-tag">Datos de ejemplo</span><span><Icon name="phone" />{company.phone}</span><span><Icon name="mail" />{company.email}</span></div>
  </div>
</div>
<header class="site-header">
  <div class="container header-inner">
    {branded ? <JJBrand href={homeHref} /> : <Brand />}
    <button class="menu-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false" aria-label="Abrir menú de navegación" hidden><span></span><span></span></button>
    <nav id="primary-navigation" aria-label="Navegación principal">
      {navigation.map((item) => <a href={navigationHref(item.href)} aria-current={aboutCurrent && item.href === '#nosotros' ? 'page' : undefined}>{item.label}</a>)}
      <a class="button button-small" href={`${anchorBase}#contacto`}>Solicitar diagnóstico <Icon /></a>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navigation = document.querySelector<HTMLElement>('#primary-navigation');
  if (toggle && navigation) {
    toggle.hidden = false;
    navigation.classList.add('enhanced');
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menú de navegación');
      navigation.classList.remove('is-open');
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      navigation.classList.toggle('is-open', open);
    });
    navigation.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        close();
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 901px)').addEventListener('change', close);
  }
</script>
<style>
  .site-header :global(.jj-monogram) { font-size: 59px; }
  .site-header :global(.jj-monogram span) { font-size: 34px; }
  .site-header :global(.jj-wordmark) { font-size: 10px; }
  @media (max-width: 650px) {
    .site-header :global(.jj-monogram) { font-size: 46px; }
    .site-header :global(.jj-monogram span) { font-size: 26px; }
    .site-header :global(.jj-wordmark) { font-size: 8px; }
  }
</style>