{
  "name": "auditores",
  "main": "worker/contact.mjs",
  "compatibility_date": "2026-10-22",
  "keep_vars": true,
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_ENABLED": "false",
    "CONTACT_ORIGIN": "https://jjconsultores.pe"
  },
  "ratelimits": [
    { "name": "CONTACT_IP_LIMITER", "namespace_id": "2026102201", "simple": { "limit": 3, "period": 60 } },
    { "name": "CONTACT_GLOBAL_LIMITER", "namespace_id": "2026102202", "simple": { "limit": 30, "period": 60 } }
  ]
}
