# Set the real public origin, without a path or trailing slash.
# Leave empty for a non-indexable local preview.
SITE_URL=
# Enable indexing only after business and publication approval.
PUBLIC_LAUNCH_READY=false
# Build-time form switch. Keep off until the Worker and provider are verified.
PUBLIC_CONTACT_ENABLED=false
PUBLIC_TURNSTILE_SITE_KEY=
# Never place RESEND_API_KEY or TURNSTILE_SECRET_KEY in PUBLIC_ variables.
